# Copy this file to ".env" and fill in your own values.

# --- database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=liquidity_lite

# --- auth ---
# any long random string works, this is used to sign login tokens
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

PORT=3000
